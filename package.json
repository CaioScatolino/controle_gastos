{
  "name": "controle-gastos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@controle-gastos/api",
    "dev:web": "npm run dev --workspace=@controle-gastos/web",
    "build:api": "npm run build --workspace=@controle-gastos/api",
    "build:web": "npm run build --workspace=@controle-gastos/web",
    "db:generate": "npm run db:generate --workspace=@controle-gastos/api",
    "db:migrate": "npm run db:migrate --workspace=@controle-gastos/api",
    "db:studio": "npm run db:studio --workspace=@controle-gastos/api"
  }
}
